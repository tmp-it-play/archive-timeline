# 데이터베이스 설정
RDB_HOST=localhost
RDB_PORT=3306
RDB_SCHEMA=hot_place_research
RDB_USER=root
RDB_PASSWORD=your_password_here
RDB_DDL_AUTO=validate

# 네이버 API 설정
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# AI 서비스 설정
AI_SERVICE_URL=http://localhost:8001
OPENAI_API_KEY=your_openai_api_key_here

# Redis 설정 (AI 서버용)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 보안 설정
ADMIN_USER=admin
ADMIN_PASSWORD=secure_password_2024!

# 로깅 설정
SHOW_SQL=false
LOG_SQL=warn
LOG_BIND=warn

# 서버 설정
SERVER_PORT=8080
