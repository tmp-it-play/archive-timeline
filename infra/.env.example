# ================================================================
# 인프라 서버 IP (이 서버 자신의 외부 IP)
# ================================================================
INFRA_HOST=CHANGE_ME
KAFKA_ADVERTISED_HOST=CHANGE_ME   # INFRA_HOST와 동일한 값

# ================================================================
# MySQL root 비밀번호 (원하는 값으로 직접 설정)
# ================================================================
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ================================================================
# Grafana 로그인 (기본값 변경 권장)
# ================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# ================================================================
# 앱 서버 IP (Prometheus 스크래핑용)
# 서버 A: gogo-user, gogo-shop
# 서버 B: gogo-stage, gogo-betting
# 서버 C: gogo-sp, gogo-minigame
# ================================================================
GOGO_USER_HOST=SERVER_A_IP
GOGO_SHOP_HOST=SERVER_A_IP
GOGO_STAGE_HOST=SERVER_B_IP
GOGO_BETTING_HOST=SERVER_B_IP
GOGO_SP_HOST=SERVER_C_IP
GOGO_MINIGAME_HOST=SERVER_C_IP
