# ================================================================
# [필수] 인프라 서버 도메인 (제공받은 도메인 그대로 입력)
# 예: abc123.infra.example.com
# ================================================================
INFRA_DOMAIN=CHANGE_ME

# ================================================================
# [필수] DB 비밀번호
# MYSQL_ROOT_PASSWORD = DB_PASSWORD 동일하게 설정
# ================================================================
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ================================================================
# Grafana 로그인
# ================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# ================================================================
# 앱 서버 도메인 (Prometheus 스크래핑용, 제공받은 도메인 입력)
# 서버 A: gogo-user(8081) + gogo-shop(8084)
# 서버 B: gogo-stage(8082) + gogo-betting(8083)
# 서버 C: gogo-sp(8085)  + gogo-minigame(8086)
# ================================================================
GOGO_SERVER_A_DOMAIN=CHANGE_ME
GOGO_SERVER_B_DOMAIN=CHANGE_ME
GOGO_SERVER_C_DOMAIN=CHANGE_ME

# ================================================================
# Google OAuth2 (user-service)
# ================================================================
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ================================================================
# JWT 시크릿 및 만료 시간 (user-service)
# accessExp / refreshExp: 초 단위 (예: 3600 = 1시간)
# ================================================================
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXP=CHANGE_ME
JWT_REFRESH_EXP=CHANGE_ME

# ================================================================
# 서버 간 내부 통신 허용 IP 대역 (user-service, stage-service)
# ================================================================
SERVER_TO_SERVER_IP=10.0.0.0
SERVER_TO_SERVER_SUBNET=/24

# ================================================================
# AWS S3 (stage-service)
# ================================================================
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_S3_BUCKET=CHANGE_ME
