# ================================================================
# [필수] 인프라 서버 IP
# ================================================================
INFRA_HOST=CHANGE_ME
KAFKA_ADVERTISED_HOST=CHANGE_ME    # INFRA_HOST와 동일하게

# ================================================================
# [필수] DB 비밀번호
# 이 값 하나가 MySQL 비밀번호 + 모든 서비스 DB 접속에 동시 적용됩니다.
# ================================================================
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME              # MYSQL_ROOT_PASSWORD와 반드시 동일하게

# ================================================================
# Grafana 로그인
# ================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# ================================================================
# 앱 서버 IP (Prometheus 스크래핑용)
# ================================================================
GOGO_USER_HOST=CHANGE_ME           # 서버 A IP
GOGO_SHOP_HOST=CHANGE_ME           # 서버 A IP (위와 동일)
GOGO_STAGE_HOST=CHANGE_ME          # 서버 B IP
GOGO_BETTING_HOST=CHANGE_ME        # 서버 B IP (위와 동일)
GOGO_SP_HOST=CHANGE_ME             # 서버 C IP
GOGO_MINIGAME_HOST=CHANGE_ME       # 서버 C IP (위와 동일)
