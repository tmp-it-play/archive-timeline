{
  "title": "Gogo - JVM 상세",
  "uid": "gogo-jvm",
  "tags": ["gogo", "jvm"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "gogo-prometheus" },
        "query": "label_values(jvm_memory_used_bytes, job)",
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "panels": [
    {
      "id": 1,
      "title": "힙 메모리 사용률",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizWidth": 75, "minVizHeight": 75 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"$service\", area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"$service\", area=\"heap\"})",
          "legendFormat": "힙 사용률",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 2,
      "title": "Non-Heap 메모리 사용률",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"$service\", area=\"nonheap\"}) / sum(jvm_memory_max_bytes{job=\"$service\", area=\"nonheap\"} > 0)",
          "legendFormat": "Non-Heap 사용률",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "title": "스레드 수",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 200 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=\"$service\"}",
          "legendFormat": "Live",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "title": "GC 횟수 (rate/min)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_count{job=\"$service\"}[1m])) * 60",
          "legendFormat": "GC/min",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "title": "메모리 영역별 사용량",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"$service\"}",
          "legendFormat": "{{id}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "title": "GC 일시정지 시간",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"$service\"}[1m])",
          "legendFormat": "{{action}} {{cause}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "title": "스레드 상태",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_threads_states_threads{job=\"$service\"}",
          "legendFormat": "{{state}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 8,
      "title": "클래스 로딩",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_classes_loaded_classes{job=\"$service\"}",
          "legendFormat": "loaded",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        },
        {
          "expr": "rate(jvm_classes_unloaded_classes_total{job=\"$service\"}[1m])",
          "legendFormat": "unloaded rate",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    }
  ]
}