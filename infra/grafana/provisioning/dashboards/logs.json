{
  "title": "Gogo - 서비스 로그",
  "uid": "gogo-logs",
  "tags": ["gogo", "loki", "logs"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "loki", "uid": "gogo-loki" },
        "query": "label_values(service)",
        "multi": false,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "sort": 1
      },
      {
        "name": "level",
        "label": "로그 레벨",
        "type": "custom",
        "options": [
          { "text": "All", "value": ".*" },
          { "text": "ERROR", "value": "ERROR" },
          { "text": "WARN", "value": "WARN" },
          { "text": "INFO", "value": "INFO" },
          { "text": "DEBUG", "value": "DEBUG" }
        ],
        "current": { "text": "All", "value": ".*" },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "로그 볼륨",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 5 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} [1m]))",
          "legendFormat": "{{service}}",
          "datasource": { "type": "loki", "uid": "gogo-loki" }
        }
      ]
    },
    {
      "id": 2,
      "title": "에러 로그 볼륨",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 20 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} |= \"ERROR\" [1m]))",
          "legendFormat": "{{service}} ERROR",
          "datasource": { "type": "loki", "uid": "gogo-loki" }
        }
      ]
    },
    {
      "id": 3,
      "title": "경고 로그 볼륨",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 20 },
          "color": { "fixedColor": "orange", "mode": "fixed" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} |= \"WARN\" [1m]))",
          "legendFormat": "{{service}} WARN",
          "datasource": { "type": "loki", "uid": "gogo-loki" }
        }
      ]
    },
    {
      "id": 4,
      "title": "로그 스트림",
      "type": "logs",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 20 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=~\"$service\"}",
          "legendFormat": "",
          "datasource": { "type": "loki", "uid": "gogo-loki" }
        }
      ]
    }
  ]
}
