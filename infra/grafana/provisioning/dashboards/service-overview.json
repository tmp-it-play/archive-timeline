{
  "title": "Gogo - 서비스 개요",
  "uid": "gogo-service-overview",
  "tags": ["gogo", "spring-boot"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "gogo-prometheus" },
        "query": "label_values(jvm_memory_used_bytes, job)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "panels": [
    {
      "id": 1,
      "title": "서비스 상태",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "up{job=~\"$service\"}", "legendFormat": "{{job}}", "datasource": { "type": "prometheus", "uid": "gogo-prometheus" } }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 요청률 (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[1m])) by (job)",
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 에러율 (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[1m])) by (job)",
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 응답시간 P99 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[1m])) by (job, le)) * 1000",
          "legendFormat": "{{job}} P99",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM 힙 메모리 사용량",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=~\"$service\", area=\"heap\"}) by (job)",
          "legendFormat": "{{job}} used",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        },
        {
          "expr": "sum(jvm_memory_max_bytes{job=~\"$service\", area=\"heap\"}) by (job)",
          "legendFormat": "{{job}} max",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU 사용률",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=~\"$service\"}",
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "title": "DB 커넥션 풀 (Hikari)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\"$service\"}",
          "legendFormat": "{{job}} active",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        },
        {
          "expr": "hikaricp_connections_pending{job=~\"$service\"}",
          "legendFormat": "{{job}} pending",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 8,
      "title": "Top 15 엔드포인트 (누적 요청 수)",
      "type": "table",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "options": {
        "sortBy": [{ "displayName": "요청 수", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "요청 수" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "custom.width", "value": 120 }] },
          { "matcher": { "id": "byName", "options": "method" }, "properties": [{ "id": "custom.width", "value": 80 }] },
          { "matcher": { "id": "byName", "options": "job" }, "properties": [{ "id": "custom.width", "value": 150 }] }
        ]
      },
      "targets": [
        {
          "expr": "topk(15, sum(increase(http_server_requests_seconds_count{job=~\"$service\"}[$__range])) by (job, method, uri))",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "Value": "요청 수" }, "excludeByName": { "Time": true, "__name__": true } } }
      ]
    },
    {
      "id": 9,
      "title": "엔드포인트별 요청률 (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[1m])) by (method, uri))",
          "legendFormat": "{{method}} {{uri}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 10,
      "title": "엔드포인트별 클라이언트 에러율 (4xx)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1 },
          "color": { "fixedColor": "orange", "mode": "fixed" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"4..\"}[1m])) by (method, uri, status))",
          "legendFormat": "{{status}} {{method}} {{uri}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    },
    {
      "id": 11,
      "title": "엔드포인트별 서버 에러율 (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 48, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[1m])) by (method, uri, status))",
          "legendFormat": "{{status}} {{method}} {{uri}}",
          "datasource": { "type": "prometheus", "uid": "gogo-prometheus" }
        }
      ]
    }
  ]
}